{
	"name": "musical-scales",
	"description": "Interactive Circle of Fifths, scales, and chord voicing explorer for piano, guitar, and cello",
	"dependencies": {
		"hono": "^4.13.18",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.69.1",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.14.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	},
	"overrides": {
		"minimatch": "^11.0.8"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	},
	"trustedDependencies": [
		"esbuild",
		"workerd"
	],
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "npm run build && vite preview"
	},
	"type": "module"
}
