{
	"name": "musical-scales",
	"description": "Interactive Circle of Fifths, scales, and chord voicing explorer for piano, guitar, violin, and cello",
	"packageManager": "bun@1.4.4",
	"dependencies": {
		"hono": "^4.13.18",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	},
	"trustedDependencies": [
		"esbuild",
		"workerd"
	],
	"private": true,
	"scripts": {
		"build": "bun check -b && vite build",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"ingest-songs": "bun scripts/ingest-songs.ts",
		"lint": "bun check -b && bun fmt --check",
		"preview": "bun run build && vite preview",
		"test": "bun test && bun fmt --check"
	},
	"type": "module"
}
